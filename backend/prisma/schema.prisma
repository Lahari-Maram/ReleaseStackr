datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Release {
  id             String   @id @default(uuid())
  name           String
  date           DateTime
  additionalInfo String?  @db.Text
  completedSteps Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("releases")
}
